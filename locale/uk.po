#: goodreads_menu.lua
msgid "Link removed"
msgstr "Зв'язок прибрано"

#: goodreads_menu.lua
msgid "Auto-track progress"
msgstr "Автовідстеження прогресу"

#: goodreads_menu.lua
msgid "Automatically set Currently reading while reading, post percent to Goodreads, and Finished at ~100% / Book Status."
msgstr "Автоматично встановлює «Читаю зараз» під час читання, надсилає відсоток на Goodreads і «Прочитано» при ~100% / Book Status."

#: goodreads_menu.lua
msgid "Change status"
msgstr "Змінити статус"

#: goodreads_menu.lua
msgid "Send rating (%1★)"
msgstr "Надіслати оцінку (%1★)"

#: goodreads_menu.lua
msgid "Send rating"
msgstr "Надіслати оцінку"

#: goodreads_menu.lua
msgid "Take ★ from KOReader Book Status and send to Goodreads (scale 1–5)."
msgstr "Взяти ★ з KOReader Book Status і надіслати на Goodreads (шкала 1–5)."

