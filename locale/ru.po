#: _meta.lua
msgid "Goodreads"
msgstr "Goodreads"

#: _meta.lua
msgid "Sync reading status, progress, and ratings with goodreads.com"
msgstr "Синхронизация статуса чтения, прогресса и оценок с goodreads.com"

#: main.lua
msgid ""
"Goodreads: session expired.\n"
"\n"
"Update cookies in Goodreads → Settings → Session cookies,\n"
"or in goodreads_config.lua (DevTools → Application → Cookies → goodreads.com).\n"
"\n"
"You do not need to restart KOReader — changes apply immediately."
msgstr ""
"Goodreads: сессия истекла.\n"
"\n"
"Обновите куки в меню Goodreads → Настройки → Куки сессии,\n"
"или в файле goodreads_config.lua (DevTools → Application → Cookies → goodreads.com).\n"
"\n"
"После обновления куки перезапускать KOReader не обязательно — изменения применяются сразу."

#: main.lua
msgid ""
"Goodreads: AWS blocked the request.\n"
"\n"
"Refresh cookies from a logged-in browser (include aws-waf-token).\n"
"Paste them in Goodreads → Settings → Session cookies,\n"
"or in goodreads_config.lua.\n"
"\n"
"You do not need to restart KOReader — changes apply immediately."
msgstr ""
"Goodreads: AWS заблокировал запрос.\n"
"\n"
"Обновите куки из браузера, где вы залогинены (включая aws-waf-token).\n"
"Вставьте их в меню Goodreads → Настройки → Куки сессии,\n"
"или в файл goodreads_config.lua.\n"
"\n"
"После обновления куки перезапускать KOReader не обязательно — изменения применяются сразу."

