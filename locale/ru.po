#: goodreads_menu.lua
msgid "Automatically set Currently reading while reading, post percent to Goodreads, and Finished at ~100% / Book Status."
msgstr "Автоматически ставить «Читаю сейчас» при чтении, отправлять процент на Goodreads и «Прочитано» при ~100% / Book Status."

#: goodreads_menu.lua
msgid "Change status"
msgstr "Изменить статус"

#: goodreads_menu.lua
msgid "Update progress: %1%"
msgstr "Обновить прогресс: %1%"

#: goodreads_menu.lua
msgid "Update progress"
msgstr "Обновить прогресс"

#: goodreads_menu.lua
msgid "Post the current KOReader percent to Goodreads as a status update. Works without auto-tracking. Want to read is switched to Currently reading. Finished / DNF / ~100% use Change status instead."
msgstr "Отправить текущий процент из KOReader на Goodreads (обновление статуса). Работает без автотрекинга. «Хочу прочитать» переключается на «Читаю сейчас». Почти 100% — через «Прочитано»."

#: goodreads_menu.lua
msgid "Send rating (%1★)"
msgstr "Отправить оценку (%1★)"

#: goodreads_menu.lua
msgid "Send rating"
msgstr "Отправить оценку"

#: goodreads_menu.lua
msgid "Take ★ from KOReader Book Status and send to Goodreads (scale 1–5)."
msgstr "Взять ★ из Book Status KOReader и отправить на Goodreads (шкала 1–5)."

